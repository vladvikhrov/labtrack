# Скопируйте в .env и заполните. Файл .env не коммитьте.

# Домен, на котором будет работать сайт (для HTTPS-сертификата и QR-кодов)
DOMAIN=labtrack.example.ru

# Длинная случайная строка: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-на-случайную-строку

# Код для самостоятельной регистрации студентов (сообщается в аудитории).
# Оставьте пустым, чтобы регистрировал только лаборант.
REGISTRATION_CODE=CODE123

ROOM_NUMBER=52-37
TIMEZONE=Europe/Moscow
SESSION_DAYS=30
